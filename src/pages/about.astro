---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title="About"
	description="Javier Jia is an educator and product leader based in Chengdu, China."
>
	<section class="content-shell py-12 space-y-8"> 
		<div class="space-y-3 max-w-3xl">
			<p class="m-0 text-sm uppercase tracking-[0.35em] text-muted">About</p>
			<h1 class="m-0 text-4xl font-semibold leading-tight text-ink">Javier Jia</h1>
			<p class="m-0 text-ink text-2xl font-semibold leading-tight">Javier Jia is the Innovative Product Development Module Leader at Chengdu University of Technology Oxford Brookes College.</p>
			<p class="m-0 text-muted">His background spans higher education and product leadership, including work as a Big Data Product Manager at Ubisoft.</p>
			<p class="m-0 text-muted">He holds PGCiE and PMP credentials and brings them to his work in product development and teaching.</p>
		</div>
	</section>
</PageLayout>
