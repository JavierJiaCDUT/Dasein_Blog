---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';

import { getSite } from '../utils/consts';
import { getPublishedProjects } from '../utils/content';
import ProjectList from '../components/ProjectList.astro';
import Social from '../components/Social.astro';

const projects = await getPublishedProjects();
const site = await getSite();
---

<PageLayout
	title={site.author.name || 'Javier Jia'}
	searchable={false}
>
	<Hero
		title={site.author.name || 'Javier Jia'}
		description={site.author.bio || 'Welcome to my personal website.'}
		role={site.author.role}
		location={site.author.location}
		actions={[
			{ label: 'View Blog', href: '/blog' },
			{ label: 'Get Quote', href: 'https://www.linkedin.com/in/jia-xinyuan-1a8a8b176' },
		]}
	/>

	<Social class="mt-8" />

	{projects.length > 0 && (
		<ProjectList
			heading="Projects"
			items={projects}
			limit={4}
			viewAllHref="/projects"
		/>
	)}

	<PostList
		heading="Blog"
		limit={3}
		viewAllHref="/blog"
	/>

</PageLayout>
