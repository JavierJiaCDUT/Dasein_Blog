---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getSite } from '../utils/consts';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata | string;
	searchable?: boolean;
	language?: string;
	alternateLanguages?: string[];
	openGraphType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	articleSection?: string;
	articleTags?: string[];
}

const site = await getSite();
const {
    title = site.author.name,
    description,
    image,
    searchable = true,
    language = 'en',
    alternateLanguages = [],
    openGraphType = 'website',
    publishedTime,
    modifiedTime,
    articleSection,
    articleTags = [],
} = Astro.props;
---

<!doctype html>
<html lang={language}>
    <head>
        <script is:inline>
            (() => {
                const storageKey = "theme-preference";
                const preferences = ["system", "light", "dark"];
                let preference = "system";

                try {
                    const stored = localStorage.getItem(storageKey);
                    if (preferences.includes(stored)) preference = stored;
                } catch {
                    // System remains the default when storage is unavailable.
                }

                const theme =
                    preference === "system"
                        ? window.matchMedia("(prefers-color-scheme: dark)").matches
                            ? "dark"
                            : "light"
                        : preference;

                document.documentElement.dataset.themePreference = preference;
                document.documentElement.dataset.theme = theme;
            })();
        </script>
        <BaseHead
            title={title}
            description={description || site.author?.bio || ''}
            image={image}
            language={language}
            alternateLanguages={alternateLanguages}
            openGraphType={openGraphType}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            articleSection={articleSection}
            articleTags={articleTags}
        />
    </head>
    <body data-pagefind-ignore={searchable ? undefined : 'all'}>
        <Header />
        <main class="content-shell" data-pagefind-body={searchable ? true : undefined}>
            <slot />
        </main>
        <Footer />
    </body>
</html>
