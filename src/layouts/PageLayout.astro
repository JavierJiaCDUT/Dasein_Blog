---
import BaseLayout from './BaseLayout.astro';

interface Props {
    title?: string;
    description?: string;
    searchable?: boolean;
    language?: string;
}

const { title, description, searchable = true, language = 'en' } = Astro.props as Props;
---

<BaseLayout title={title} description={description} searchable={searchable} language={language}>
    <div class="flex flex-col pb-16 min-h-[calc(100vh-var(--grid-cell)*2)]">
        <slot />
    </div>
</BaseLayout>
