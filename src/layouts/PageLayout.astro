---
import BaseLayout from './BaseLayout.astro';

interface Props {
    title?: string;
    description?: string;
    searchable?: boolean;
}

const { title, description, searchable = true } = Astro.props as Props;
---

<BaseLayout title={title} description={description} searchable={searchable}>
    <div class="flex flex-col pb-16 min-h-[calc(100vh-var(--grid-cell)*2)]">
        <slot />
    </div>
</BaseLayout>
