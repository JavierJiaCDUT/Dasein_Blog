---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Prose from '../components/Prose.astro';
import { slugify, withBase } from '../utils/slugify';

type ContentType =
    | 'Original'
    | 'Translation'
    | 'Bilingual Translation'
    | 'Repost'
    | 'Summary'
    | 'Commentary';

type TranslationMethod = 'AI-Assisted' | 'Human' | 'Hybrid';

interface Source {
    id?: string;
    resource: string;
    title?: string;
    author?: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
    type?: string;
    author?: string;
    contentType?: ContentType;
    language?: string[];
    translationMethod?: TranslationMethod;
    translator?: string;
    originalPubDate?: Date;
    resource?: string;
    sources?: Source[];
    heroImage?: ImageMetadata;
    Content?: any;
    tags?: string[];
}

const {
    title,
    description,
    pubDate,
    updatedDate,
    type,
    author,
    contentType,
    language = [],
    translationMethod,
    translator,
    originalPubDate,
    resource,
    sources = [],
    heroImage,
    tags = [],
    Content,
} = Astro.props as Props;

const languageNames: Record<string, string> = {
    en: 'English',
    'zh-CN': '简体中文',
};
const languageLabel = language.map((code) => languageNames[code] ?? code).join(' / ');
const [primaryLanguage = 'en', ...alternateLanguages] = language;
const sourceMap = new Map(sources.map((source) => [source.resource, source]));

if (resource && !sourceMap.has(resource)) {
    sourceMap.set(resource, {
        resource,
        title: 'Primary source',
    });
}

const displayedSources = Array.from(sourceMap.values());
const isResearchSummary = type === 'Research Summary';
const isExternalAdaptation = ['Translation', 'Bilingual Translation', 'Repost', 'Summary'].includes(
    contentType ?? '',
);
const authorLabel = isResearchSummary ? 'Research by' : isExternalAdaptation ? 'Original work by' : 'By';
const hasAttribution = Boolean(
    author ||
    contentType ||
    translationMethod ||
    translator ||
    originalPubDate ||
    displayedSources.length,
);
---

<BaseLayout
    title={title}
    description={description}
    image={heroImage}
    language={primaryLanguage}
    alternateLanguages={alternateLanguages}
    openGraphType="article"
    publishedTime={pubDate}
    modifiedTime={updatedDate}
    articleSection={type ?? 'Journal'}
    articleTags={tags}
>
    <div class="flex-1 flex flex-col py-12 md:py-16 lg:py-20 space-y-16">
    <article class="post-page max-w-4xl w-full mx-auto">
        <header class="section-heading">
            <p class="eyebrow">Journal</p>
            <h1 data-pagefind-weight="10">{title}</h1>
            <p class="post-meta">
                <FormattedDate date={pubDate} />
                {updatedDate && (
                    <span>
                        &middot; Updated <FormattedDate date={updatedDate} />
                    </span>
                )}
            </p>
                {tags.length > 0 && (
                    <ul class="mt-2 flex flex-wrap gap-2 text-sm text-muted">
                        {tags.map((tag) => (
                            <li class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1">
                                <a class="hover:text-ink" href={withBase(`/tags/${slugify(tag)}/`)}>{tag}</a>
                            </li>
                        ))}
                    </ul>
                )}
                {hasAttribution && (
                    <aside class="mt-5 max-w-2xl border-l-2 border-ink pl-4 text-sm text-muted" aria-label="Article attribution">
                        <p class="m-0 text-xs font-semibold uppercase tracking-[0.2em] text-ink">Source &amp; attribution</p>
                        {author && (
                            <p class="m-0 mt-2">
                                {authorLabel} <strong class="font-semibold text-ink">{author}</strong>
                                {originalPubDate && (
                                    <span>
                                        {' · '}Published <FormattedDate date={originalPubDate} />
                                    </span>
                                )}
                            </p>
                        )}
                        {(contentType || languageLabel) && (
                            <p class="m-0 mt-1">
                                {contentType}
                                {contentType && languageLabel && ' · '}
                                {languageLabel}
                            </p>
                        )}
                        {translationMethod === 'AI-Assisted' && (
                            <p class="m-0 mt-1">
                                Chinese translation: <strong class="font-semibold text-ink">AI-assisted</strong>
                            </p>
                        )}
                        {translationMethod === 'Human' && translator && (
                            <p class="m-0 mt-1">
                                Chinese translation by <strong class="font-semibold text-ink">{translator}</strong>
                            </p>
                        )}
                        {translationMethod === 'Hybrid' && translator && (
                            <p class="m-0 mt-1">
                                Chinese translation by <strong class="font-semibold text-ink">{translator}</strong>, with AI assistance
                            </p>
                        )}
                        {displayedSources.length > 0 && (
                            <div class="mt-3">
                                <p class="m-0 font-semibold text-ink">Sources</p>
                                <ul class="m-0 mt-1 list-none space-y-1 p-0">
                                    {displayedSources.map((source) => (
                                        <li>
                                            <a
                                                class="font-semibold text-ink underline decoration-border underline-offset-4 hover:decoration-ink"
                                                href={source.resource}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                {source.title ?? 'Primary source'} <span aria-hidden="true">↗</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </aside>
                )}
        </header>

        {heroImage && (
            <figure class="post-hero-image">
                <Image width={1020} height={510} src={heroImage} alt="" />
            </figure>
        )}

        <section class="post-article">
            <Prose>
                {Content ? <Content /> : <slot />}
            </Prose>
        </section>
    </article>
    </div>
</BaseLayout>
