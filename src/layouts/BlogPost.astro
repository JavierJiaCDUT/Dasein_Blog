---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Prose from '../components/Prose.astro';
import { slugify, withBase } from '../utils/slugify';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
    author?: string;
    contentType?: string;
    language?: string[];
    translator?: string;
    originalPubDate?: Date;
    resource?: string;
    heroImage?: ImageMetadata;
    Content?: any;
    tags?: string[];
}

const {
    title,
    description,
    pubDate,
    updatedDate,
    author,
    contentType,
    language = [],
    translator,
    originalPubDate,
    resource,
    heroImage,
    tags = [],
    Content,
} = Astro.props as Props;

const languageNames: Record<string, string> = {
    en: 'English',
    'zh-CN': '简体中文',
};
const languageLabel = language.map((code) => languageNames[code] ?? code).join(' / ');
const hasAttribution = Boolean(author || contentType || translator || originalPubDate || resource);
---

<BaseLayout title={title} description={description} image={heroImage}>
    <div class="flex-1 flex flex-col py-12 md:py-16 lg:py-20 space-y-16">
    <article class="post-page max-w-4xl w-full mx-auto">
        <header class="section-heading">
            <p class="eyebrow">Journal</p>
            <h1>{title}</h1>
            <p class="post-meta">
                <FormattedDate date={pubDate} />
                {updatedDate && (
                    <span>
                        &middot; Updated <FormattedDate date={updatedDate} />
                    </span>
                )}
            </p>
                {tags.length > 0 && (
                    <ul class="mt-2 flex flex-wrap gap-2 text-sm text-muted">
                        {tags.map((tag) => (
                            <li class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1">
                                <a class="hover:text-ink" href={withBase(`/tags/${slugify(tag)}/`)}>{tag}</a>
                            </li>
                        ))}
                    </ul>
                )}
                {hasAttribution && (
                    <aside class="mt-5 max-w-2xl border-l-2 border-ink pl-4 text-sm text-muted" aria-label="Article attribution">
                        <p class="m-0 text-xs font-semibold uppercase tracking-[0.2em] text-ink">Source &amp; translation</p>
                        {author && (
                            <p class="m-0 mt-2">
                                Original article by <strong class="font-semibold text-ink">{author}</strong>
                                {originalPubDate && (
                                    <span>
                                        {' · '}Published <FormattedDate date={originalPubDate} />
                                    </span>
                                )}
                            </p>
                        )}
                        {(contentType || languageLabel) && (
                            <p class="m-0 mt-1">
                                {contentType}
                                {contentType && languageLabel && ' · '}
                                {languageLabel}
                            </p>
                        )}
                        {translator && (
                            <p class="m-0 mt-1">
                                Chinese translation by <strong class="font-semibold text-ink">{translator}</strong>
                            </p>
                        )}
                        {resource && (
                            <a
                                class="mt-3 inline-flex font-semibold text-ink underline decoration-border underline-offset-4 hover:decoration-ink"
                                href={resource}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Read the original article <span class="ml-1" aria-hidden="true">↗</span>
                            </a>
                        )}
                    </aside>
                )}
        </header>

        {heroImage && (
            <figure class="post-hero-image">
                <Image width={1020} height={510} src={heroImage} alt="" />
            </figure>
        )}

        <section class="post-article">
            <Prose>
                {Content ? <Content /> : <slot />}
            </Prose>
        </section>
    </article>
    </div>
</BaseLayout>
