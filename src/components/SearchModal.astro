---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
---

<PagefindConfig />
<pagefind-modal>
  <pagefind-modal-header>
    <pagefind-input></pagefind-input>
  </pagefind-modal-header>
  <pagefind-modal-body>
    <pagefind-summary></pagefind-summary>
    <pagefind-results hide-sub-results></pagefind-results>
  </pagefind-modal-body>
  <pagefind-modal-footer>
    <pagefind-keyboard-hints></pagefind-keyboard-hints>
  </pagefind-modal-footer>
</pagefind-modal>

<script>
  let searchOpener: HTMLElement | null = null;

  const getTriggerButton = (trigger: Element | null) =>
    trigger?.querySelector("button") instanceof HTMLElement
      ? trigger.querySelector<HTMLElement>("button")
      : null;

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest("pagefind-modal-trigger");
    if (trigger) searchOpener = getTriggerButton(trigger);
  });

  document.addEventListener("keydown", (event) => {
    const isSearchShortcut =
      event.key.toLowerCase() === "k" &&
      (event.metaKey || event.ctrlKey) &&
      !event.altKey &&
      !event.shiftKey;

    if (!isSearchShortcut) return;

    const visibleTrigger = Array.from(
      document.querySelectorAll("pagefind-modal-trigger"),
    ).find((trigger) => trigger.getClientRects().length > 0);

    searchOpener =
      getTriggerButton(visibleTrigger ?? null) ??
      (document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null);
  });

  customElements.whenDefined("pagefind-modal").then(() => {
    const modal = document.querySelector("pagefind-modal");
    const dialog = modal?.querySelector("dialog");

    dialog?.addEventListener("close", () => {
      queueMicrotask(() => {
        document
          .querySelectorAll<HTMLElement>("pagefind-modal-trigger button")
          .forEach((button) => {
            button.setAttribute("aria-expanded", "false");
          });

        const focusTarget =
          searchOpener && searchOpener.getClientRects().length > 0
            ? searchOpener
            : document.getElementById("nav-toggle");

        if (
          focusTarget instanceof HTMLElement &&
          focusTarget.getClientRects().length > 0
        ) {
          focusTarget.focus();
        }

        searchOpener = null;
      });
    });
  });
</script>
