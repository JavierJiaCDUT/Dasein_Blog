---
// Theme toggle button with local storage persistence
export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props as Props;
---

<button
	type="button"
	data-theme-toggle
	aria-label="Theme preference: System. Switch to Light"
	class={className}
>
	<span class="sr-only">Theme preference</span>
	<span data-theme-label aria-hidden="true">System</span>
</button>

<script>
const STORAGE_KEY = 'theme-preference';
const PREFERENCES = ['system', 'light', 'dark'];
const SYSTEM_THEME = window.matchMedia('(prefers-color-scheme: dark)');

const getStoredPreference = () => {
	try {
		const stored = localStorage.getItem(STORAGE_KEY);
		return PREFERENCES.includes(stored ?? '') ? stored : 'system';
	} catch {
		return 'system';
	}
};

const resolveTheme = (preference) =>
	preference === 'system'
		? SYSTEM_THEME.matches
			? 'dark'
			: 'light'
		: preference;

const nextPreference = (preference) => {
	const index = PREFERENCES.indexOf(preference);
	return PREFERENCES[(index + 1) % PREFERENCES.length];
};

const formatPreference = (preference) =>
	preference.charAt(0).toUpperCase() + preference.slice(1);

const applyPreference = (preference) => {
	const theme = resolveTheme(preference);
	const next = nextPreference(preference);
	document.documentElement.dataset.themePreference = preference;
	document.documentElement.dataset.theme = theme;

	const buttons = document.querySelectorAll('[data-theme-toggle]');
	buttons.forEach((button) => {
		const label = button.querySelector('[data-theme-label]');
		if (label) label.textContent = formatPreference(preference);
		button.setAttribute(
			'aria-label',
			`Theme preference: ${formatPreference(preference)}. Switch to ${formatPreference(next)}`,
		);
	});
};

const savePreference = (preference) => {
	try {
		if (preference === 'system') {
			localStorage.removeItem(STORAGE_KEY);
		} else {
			localStorage.setItem(STORAGE_KEY, preference);
		}
	} catch {
		// The selected preference still applies for the current page.
	}
};

const cyclePreference = () => {
	const current =
		document.documentElement.dataset.themePreference || getStoredPreference();
	const next = nextPreference(current);
	savePreference(next);
	applyPreference(next);
};

document.addEventListener('click', (e) => {
	const t = e.target;
	if (!(t instanceof Element)) return;
	const btn = t.closest('[data-theme-toggle]');
	if (!btn) return;
	e.preventDefault();
	cyclePreference();
});

SYSTEM_THEME.addEventListener('change', () => {
	if (document.documentElement.dataset.themePreference === 'system') {
		applyPreference('system');
	}
});

applyPreference(getStoredPreference());
</script>
